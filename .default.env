# Включить mock-режим вместо реального API.
# Если false (или не задан) — используется ApiPartsRepository с реальными HTTP-запросами.
VITE_MOCK=true

# Глобальный сценарий для всех репозиториев.
# Применяется, если у конкретного репозитория нет своего VITE_*_SCENARIO.
#
# Значения:
#   happy-path   — нормальная работа, реалистичная задержка (по умолчанию)
#   empty        — пустой каталог, данных нет
#   server-error — 500 на все запросы
#   loading      — бесконечная загрузка
#   not-found    — список пуст, запросы по ID возвращают 404
VITE_SCENARIO=happy-path

# Сценарий для репозитория Parts. Переопределяет VITE_SCENARIO.
# VITE_PARTS_SCENARIO=happy-path
