{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true,
		"jsx": "react-jsx",
		"outDir": "dist",
		"types": ["vitest/globals", "vite/client"]
	},
	"include": ["core", "adapters", "examples", "tests", "index.ts", "vite.config.ts", "vitest.config.ts"]
}
